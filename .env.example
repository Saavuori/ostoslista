# Postgres connection used by the app and by drizzle-kit.
# Local dev with no Docker required (Postgres compiled to WASM, in-process):
DATABASE_URL=pglite://.data/dev
# A real server instead:
# DATABASE_URL=postgres://ostoslista:ostoslista@localhost:5432/ostoslista

# Which K-Ruoka store's assortment and prices to use by default.
# N106 = K-Citymarket Iso Omena. Change to your own store.
KRUOKA_DEFAULT_STORE=N106

# How long a cached store price stays fresh, in seconds.
PRICE_TTL_SECONDS=21600

# Public origin, used to build share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
